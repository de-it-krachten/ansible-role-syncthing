---

# Generic
generic:
  role: ansible-role-syncthing
  role_short: syncthing
  role_description: |
    <basic role description>
  collections: []

# Molecule
molecule:
  requirements:
    roles_extra: []
  nodes:
    - name: master
      groups: ['syncthing_masters']
    - name: client1
      groups: ['syncthing_clients']
    - name: client2
      groups: ['syncthing_clients']
  prepare:
    vars:
      prepare_firewall: false
      register_hosts: false
  converge:
    vars:
      syncthing_user: syncthing
      syncthing_folders:
        - id: f2c6b06bf7d0bc8f6471e3c97933dd421cf9e864
          label: test01
          path: "{{ syncthing_home }}/test01"
        - id: 534e995fef5b8e236deffa878228172dad0578e1
          label: test02
          path: "{{ syncthing_home }}/test02"
          encryption_password: BNaFIsMKcpD+yhzv+zNLP4b8VG5CyWnKPSXchLhBNOs=

# CI templates
ci_templates:
  converge.yml:
    force: false
